# 로컬 수동 제출용 자격증명. 이 파일을 .env.submit 으로 복사해서 채운다.
# .env.submit 은 커밋 금지 (.gitignore에 등록됨). CI는 이 값들을 리포지토리 시크릿으로 받는다.

# 웹스토어 개발자 대시보드 → 확장 항목 URL의 ID
CHROME_EXTENSION_ID=

# 웹스토어 개발자 대시보드 → Publisher > Settings의 Publisher ID
CHROME_PUBLISHER_ID=

# Google Cloud 서비스 계정 이메일과 JSON 키의 private_key 값
# 서비스 계정을 웹스토어 개발자 대시보드 Account에 추가해야 한다.
CHROME_SERVICE_ACCOUNT_CLIENT_EMAIL=
CHROME_SERVICE_ACCOUNT_PRIVATE_KEY=
