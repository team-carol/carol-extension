# 로컬 수동 제출용 자격증명. 이 파일을 .env.submit 으로 복사해서 채운다.
# .env.submit 은 커밋 금지 (.gitignore에 등록됨). CI는 이 값들을 리포지토리 시크릿으로 받는다.

# 웹스토어 개발자 대시보드 → 확장 항목 URL의 ID
CHROME_EXTENSION_ID=

# Google Cloud Console에서 만든 OAuth 2.0 클라이언트 (Desktop app)
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=

# 아래 스코프로 1회 발급한 refresh token
#   https://www.googleapis.com/auth/chromewebstore
CHROME_REFRESH_TOKEN=
